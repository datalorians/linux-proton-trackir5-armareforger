#!/usr/bin/env python3
import os
import select
import signal
import sys
import time
from pathlib import Path

from evdev import AbsInfo, InputDevice, UInput, ecodes


STICK = Path("/dev/input/by-id/usb-Madcatz_Saitek_Pro_Flight_X-55_Rhino_Stick_G0013831-event-joystick")
THROTTLE = Path("/dev/input/by-id/usb-Madcatz_Saitek_Pro_Flight_X-55_Rhino_Throttle_G0019162-event-joystick")
STATE_DIR = Path.home() / ".local/state/x55-arma-reforger"
PID_FILE = STATE_DIR / "virtual-gamepad.pid"


def die(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def scale(value, src_min, src_max, dst_min=-32768, dst_max=32767, invert=False):
    if src_max == src_min:
        return 0
    value = max(src_min, min(src_max, value))
    ratio = (value - src_min) / (src_max - src_min)
    if invert:
        ratio = 1.0 - ratio
    return int(dst_min + ratio * (dst_max - dst_min))


def centered(value, info, invert=False):
    return scale(value, info.min, info.max, -32768, 32767, invert=invert)


def read_abs_info(device, code):
    info = device.absinfo(code)
    if info is None:
        die(f"{device.path} does not expose required axis {ecodes.ABS[code]}")
    return info


def main():
    if not STICK.exists():
        die(f"X-55 stick not found: {STICK}")
    if not THROTTLE.exists():
        die(f"X-55 throttle not found: {THROTTLE}")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))

    stick = InputDevice(str(STICK))
    throttle = InputDevice(str(THROTTLE))

    stick_x = read_abs_info(stick, ecodes.ABS_X)
    stick_y = read_abs_info(stick, ecodes.ABS_Y)
    stick_rz = read_abs_info(stick, ecodes.ABS_RZ)
    throttle_left = read_abs_info(throttle, ecodes.ABS_X)
    throttle_right = read_abs_info(throttle, ecodes.ABS_Y)

    invert_pitch = os.environ.get("X55_REFORGER_INVERT_PITCH", "1") != "0"
    invert_collective = os.environ.get("X55_REFORGER_INVERT_COLLECTIVE", "1") != "0"
    invert_yaw = os.environ.get("X55_REFORGER_INVERT_YAW", "0") != "0"

    caps = {
        ecodes.EV_KEY: [
            ecodes.BTN_SOUTH,
            ecodes.BTN_EAST,
            ecodes.BTN_NORTH,
            ecodes.BTN_WEST,
            ecodes.BTN_TL,
            ecodes.BTN_TR,
            ecodes.BTN_SELECT,
            ecodes.BTN_START,
            ecodes.BTN_MODE,
            ecodes.BTN_THUMBL,
            ecodes.BTN_THUMBR,
        ],
        ecodes.EV_ABS: [
            (ecodes.ABS_X, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_Y, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_RX, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_RY, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_Z, AbsInfo(0, 0, 255, 0, 0, 0)),
            (ecodes.ABS_RZ, AbsInfo(0, 0, 255, 0, 0, 0)),
            (ecodes.ABS_HAT0X, AbsInfo(0, -1, 1, 0, 0, 0)),
            (ecodes.ABS_HAT0Y, AbsInfo(0, -1, 1, 0, 0, 0)),
        ],
    }

    ui = UInput(
        caps,
        name="Microsoft X-Box 360 pad",
        vendor=0x045E,
        product=0x028E,
        version=0x0114,
        bustype=ecodes.BUS_USB,
    )

    running = True

    def stop(_signum, _frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    try:
        stick.grab()
        throttle.grab()
    except OSError as exc:
        die(f"Could not grab X-55 devices: {exc}")

    left_throttle_value = throttle_left.value
    right_throttle_value = throttle_right.value

    def write_defaults():
        ui.write(ecodes.EV_ABS, ecodes.ABS_X, centered(stick_rz.value, stick_rz, invert=invert_yaw))
        ui.write(ecodes.EV_ABS, ecodes.ABS_Y, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_RX, centered(stick_x.value, stick_x))
        ui.write(ecodes.EV_ABS, ecodes.ABS_RY, centered(stick_y.value, stick_y, invert=invert_pitch))
        ui.write(ecodes.EV_ABS, ecodes.ABS_Z, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_RZ, 0)
        ui.syn()

    def update_collective():
        mixed = int((left_throttle_value + right_throttle_value) / 2)
        ui.write(ecodes.EV_ABS, ecodes.ABS_Y, scale(mixed, throttle_left.min, throttle_left.max, -32768, 32767, invert=invert_collective))

    write_defaults()
    print("Started X-55 virtual Xbox 360 gamepad for Arma Reforger.")
    print("Mapping: stick X/Y -> right stick, twist -> left stick X, throttle -> left stick Y.")
    print(f"PID: {os.getpid()}")
    sys.stdout.flush()

    devices = {stick.fd: stick, throttle.fd: throttle}
    try:
        while running:
            readable, _, _ = select.select(list(devices), [], [], 0.1)
            for fd in readable:
                dev = devices[fd]
                for event in dev.read():
                    if event.type == ecodes.EV_ABS:
                        if dev is stick:
                            if event.code == ecodes.ABS_X:
                                ui.write(ecodes.EV_ABS, ecodes.ABS_RX, centered(event.value, stick_x))
                            elif event.code == ecodes.ABS_Y:
                                ui.write(ecodes.EV_ABS, ecodes.ABS_RY, centered(event.value, stick_y, invert=invert_pitch))
                            elif event.code == ecodes.ABS_RZ:
                                ui.write(ecodes.EV_ABS, ecodes.ABS_X, centered(event.value, stick_rz, invert=invert_yaw))
                            elif event.code == ecodes.ABS_HAT0X:
                                ui.write(ecodes.EV_ABS, ecodes.ABS_HAT0X, event.value)
                            elif event.code == ecodes.ABS_HAT0Y:
                                ui.write(ecodes.EV_ABS, ecodes.ABS_HAT0Y, event.value)
                        else:
                            if event.code == ecodes.ABS_X:
                                left_throttle_value = event.value
                                update_collective()
                            elif event.code == ecodes.ABS_Y:
                                right_throttle_value = event.value
                                update_collective()
                    elif event.type == ecodes.EV_KEY:
                        button_map = {
                            ecodes.BTN_TRIGGER: ecodes.BTN_TR,
                            ecodes.BTN_THUMB: ecodes.BTN_SOUTH,
                            ecodes.BTN_THUMB2: ecodes.BTN_EAST,
                            ecodes.BTN_TOP: ecodes.BTN_NORTH,
                            ecodes.BTN_TOP2: ecodes.BTN_WEST,
                            ecodes.BTN_PINKIE: ecodes.BTN_TL,
                            ecodes.BTN_BASE: ecodes.BTN_SELECT,
                            ecodes.BTN_BASE2: ecodes.BTN_START,
                        }
                        target = button_map.get(event.code)
                        if target is not None:
                            ui.write(ecodes.EV_KEY, target, event.value)
                    ui.syn()
    finally:
        try:
            stick.ungrab()
            throttle.ungrab()
        finally:
            ui.close()
            try:
                PID_FILE.unlink()
            except FileNotFoundError:
                pass


if __name__ == "__main__":
    main()
