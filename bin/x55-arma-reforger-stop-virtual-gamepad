#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${HOME}/.local/state/x55-arma-reforger"
PID_FILE="${STATE_DIR}/virtual-gamepad.pid"

if [[ -f "${PID_FILE}" ]]; then
  old_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  if [[ -n "${old_pid}" ]] && kill -0 "${old_pid}" 2>/dev/null; then
    kill "${old_pid}" || true
  fi
fi

while read -r old_pid; do
  [[ -n "${old_pid}" ]] || continue
  kill "${old_pid}" || true
done < <(pgrep -f "[x]55-arma-reforger-virtual-gamepad" || true)

rm -f "${PID_FILE}"
echo "Stopped X-55 virtual gamepad for Arma Reforger."
